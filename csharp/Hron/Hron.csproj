<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Hron</PackageId>
    <Version>1.0.0</Version>
    <Authors>Prasanna Ram Venkatachalam</Authors>
    <Description>Human-readable cron expressions</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://hron.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simpllyf/hron</RepositoryUrl>
    <PackageTags>cron;scheduling;parser</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enum members and record positional properties need no doc that only restates their name (AGENTS.md, "Comments"). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
